GCC 12+ fix: capacity() returns an unsigned type, so std::max(unsigned - int, 0)
fails to deduce a common template argument and the build stops. Cast to int,
which is also what the surrounding arithmetic assumes.

diff --git a/bmatching/ilp/ilp_ball.h b/bmatching/ilp/ilp_ball.h
index 9b7a53e..919a588 100644
--- a/bmatching/ilp/ilp_ball.h
+++ b/bmatching/ilp/ilp_ball.h
@@ -84,7 +84,9 @@ void improveMatchingByILP(BMatching &bmatching,
         }
       }
       model.addConstr(nodeLimit <=
-                          std::max(bmatching.capacity(v) - outside_edges, 0),
+                          std::max(static_cast<int>(bmatching.capacity(v)) -
+                                       outside_edges,
+                                   0),
                       "valid bmatching");
     }
     model.setObjective(edgeWeightSum, GRB_MAXIMIZE);
